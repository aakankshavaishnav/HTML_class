body {
    margin: 0;
    display: flex;
    justify-content: center;
}

.cont {
    width: 600px;
    height: 600px;
    position: relative;
    border: 1px solid black;
}

/* Top part */
.top {
    width: 100%;
    height: 40%;
    position: absolute;
    top: 0;
    display: flex;
    justify-content: space-between;
}

.red {
    width: 40%;
    height: 100%;
    background: red;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-evenly;
    align-content: space-evenly;
}

.green {
    width: 40%;
    height: 100%;
    background: green;
}

/* Middle paths */
.path {
    width: 20%;
    height: 100%;
    border: 1px solid black;
    box-sizing: border-box;
    background: white;
}

/* Red tokens */
.rtoken {
    width: 35px;
    height: 35px;
    border: 4px solid red;
    border-radius: 50%;
    background: white;
}

/* Green tokens */
.gtoken {
    width: 35px;
    height: 35px;
    border: 4px solid green;
    border-radius: 50%;
    background: white;
}

/* Middle section */
.middle {
    width: 100%;
    height: 20%;
    position: absolute;
    top: 40%;
    display: flex;
    border: 1px solid black;
    box-sizing: border-box;
}

.middle div {
    width: 50%;
    height: 100%;
    border: 1px solid black;
    box-sizing: border-box;
}

/* Bottom part */
.bottom {
    width: 100%;
    height: 40%;
    position: absolute;
    bottom: 0;
    display: flex;
    justify-content: space-between;
}

.yellow {
    width: 40%;
    height: 100%;
    background: yellow;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-evenly;
    align-content: space-evenly;
}

.blue {
    width: 40%;
    height: 100%;
    background: blue;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-evenly;
    align-content: space-evenly;
}

/* Yellow tokens */
.ytoken {
    width: 35px;
    height: 35px;
    border: 4px solid yellow;
    border-radius: 50%;
    background: white;
}

/* Blue tokens */
.gblue {
    width: 35px;
    height: 35px;
    border: 4px solid blue;
    border-radius: 50%;
    background: white;
}
